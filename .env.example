# ─── SafeTracks — Insurance Restoration Platform ─────────────────────────────
# Copy this file to .env and fill in real values before running.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://safetracks:password@localhost:5432/safetracks_restoration"

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# JWT secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-string"

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,https://app.safetracks.io"

# Web app base URL (used for QR code generation)
WEB_BASE_URL="http://localhost:3000"

# ─── Hedera Hashgraph ─────────────────────────────────────────────────────────
# Network: testnet | mainnet | previewnet
HEDERA_NETWORK="testnet"

# Your Hedera account (from portal.hedera.com)
HEDERA_ACCOUNT_ID="0.0.XXXXXXX"

# DER-encoded private key (ECDSA or Ed25519)
HEDERA_PRIVATE_KEY="302e020100300506032b657004220420..."

# ─── Aleo ─────────────────────────────────────────────────────────────────────
# Network: testnet | mainnet
ALEO_NETWORK="testnet"

# Program ID after deployment
ALEO_PROGRAM_ID="restoration_proof_v1.aleo"

# Aleo program address (derived from program ID)
ALEO_PROGRAM_ADDRESS="aleo1..."

# ─── Anthropic (Claude Vision) ───────────────────────────────────────────────
# Required for AI vision features: meter OCR, damage classification, doc extraction
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ─── Pinata IPFS Storage ──────────────────────────────────────────────────────
# Sign up free at https://app.pinata.cloud — free tier is 1 GB, enough for a pilot
# Generate an API key under Developers → API Keys (select "Pinata Admin" or "pinFileToIPFS")
PINATA_JWT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Optional: your dedicated gateway subdomain (faster than public gateway)
PINATA_GATEWAY="https://gateway.pinata.cloud"

# ─── Bethelnet (v2 — not used in v1-pilot) ────────────────────────────────────
# BETHELNET_API_URL="https://api.bethelnet.io/v1"
# BETHELNET_API_KEY="your-bethelnet-api-key-here"

# ─── Aleo ZK (v2 — not used in v1-pilot) ─────────────────────────────────────
# ALEO_NETWORK="testnet"
# ALEO_PROGRAM_ID="restoration_proof_v1.aleo"
# ALEO_PROGRAM_ADDRESS="aleo1..."

# ─── Next.js Web App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HEDERA_NETWORK="testnet"

# ─── Mobile (Expo) ────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:4000"
